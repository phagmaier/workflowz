{
  "name": "agent-workflow-runner",
  "version": "0.0.0",
  "private": true,
  "description": "Local deterministic workflow runner for coding-agent harnesses",
  "type": "module",
  "engines": {
    "node": ">=26.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/build-ui.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p ui/tsconfig.json",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "npm run build && node --test \"dist/**/*.test.js\" \"ui/src/**/*.test.ts\"",
    "check": "npm run typecheck && npm run lint && npm test",
    "test:browser": "npm run build --silent && node scripts/smoke-browser.mjs",
    "validate": "npm run build --silent && node dist/app/validate-cli.js",
    "probe:harnesses": "npm run build --silent && node dist/adapters/probe-cli.js",
    "smoke:reporting": "npm run build --silent && node scripts/smoke-reporting.mjs",
    "smoke:capabilities": "npm run build --silent && node scripts/smoke-capabilities.mjs",
    "smoke:tasks": "npm run build --silent && node scripts/smoke-tasks.mjs",
    "smoke:boundaries": "npm run build --silent && node scripts/smoke-boundaries.mjs",
    "smoke:recovery": "npm run build --silent && node scripts/smoke-recovery.mjs",
    "smoke:harnesses": "npm run build --silent && node dist/app/harness-smoke-cli.js",
    "smoke:meta": "npm run build --silent && node dist/app/meta-smoke-cli.js"
  },
  "dependencies": {
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "7.0.2",
    "vite": "8.3.4"
  },
  "bin": {
    "wf": "bin/wf"
  }
}
